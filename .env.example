# ── JARVIS OS — Environment ────────────────────────────────────
# Copy to .env.local and fill in ONE provider to unlock the full
# language model. Every value is optional: with no keys, JARVIS runs
# on its built-in local core (desktop control, timers, memory).
#
# Server-side keys are used when no key is saved in Settings →
# Intelligence. Keys are only read inside /api/jarvis and are never
# sent to the browser.

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=AIza...

# Groq
# GROQ_API_KEY=gsk_...

# OpenRouter
# OPENROUTER_API_KEY=sk-or-...

# Ollama (local models — no API key)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any OpenAI-compatible endpoint (LM Studio, vLLM, Together, DeepSeek…)
# CUSTOM_AI_BASE_URL=https://api.example.com/v1
# CUSTOM_AI_API_KEY=
